# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Sentry environment tag: local | staging | production
NEXT_PUBLIC_APP_ENV=local

# Supabase Configuration
# Get these from your Supabase project dashboard:
# Settings → API → Project API keys
#
# PUBLISHABLE_KEY: Safe to use in client-side code (respects Row Level Security)
# SECRET_KEY: Server-side only, bypasses RLS (keep this secret!)
# Code also accepts SUPABASE_SERVICE_ROLE_KEY as an alias for the secret key.
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Supabase CLI (remote db push / deploy) — database password from Dashboard → Settings → Database
# SUPABASE_DB_PASSWORD=your-database-password

# Email (Resend) — used by Next.js and Supabase notify edge function
RESEND_API_KEY=your-resend-api-key-here

# Sentry (optional locally; required for production error reporting)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Stripe (lifetime checkout + billing webhooks)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Webhook signing secret (starts with whsec_) - from Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Database seeding (scripts/seed-db.ts) — optional
# SEED_OWNER_EMAIL=owner@example.com
# SEED_OWNER_PASSWORD=password123
# SEED_CREATE_AUTH_USERS=owner
